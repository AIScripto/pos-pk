#!/usr/bin/env bash

# Git Pre-Commit Hook for Crip-Crumbs Monorepo
# Checks staged files, runs linters on staged changes, and performs type-checking.
# Generates a detailed Error Report if any check fails.

# Colors and formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Setup temporary directory for log outputs
TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'githook')
trap 'rm -rf "$TMP_DIR"' EXIT

LOG_CONFLICT="$TMP_DIR/conflict.log"
LOG_ESLINT="$TMP_DIR/eslint.log"
LOG_FE_TYPECHECK="$TMP_DIR/fe_typecheck.log"
LOG_BE_TYPECHECK="$TMP_DIR/be_typecheck.log"

REPORT_LOG=".git/githooks_precommit_error.log"

STATUS_CONFLICT="SKIPPED"
STATUS_ESLINT="SKIPPED"
STATUS_FE_TYPECHECK="SKIPPED"
STATUS_BE_TYPECHECK="SKIPPED"

FAILED=0

echo -e "${CYAN}======================================================${NC}"
echo -e "${CYAN}${BOLD}  🔍 Running Pre-Commit Verification...               ${NC}"
echo -e "${CYAN}======================================================${NC}"

# 1. Check for Git merge conflict markers in staged files
echo -e "\n${BOLD}[1/4] Checking for unresolved merge conflicts...${NC}"
CONFLICT_FILES=$(git diff --cached --name-only | xargs grep -E -l "^(<<<<<<<|=======|>>>>>>>)" 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
  echo -e "${RED}❌ Merge conflict markers found in staged files.${NC}"
  echo "$CONFLICT_FILES" > "$LOG_CONFLICT"
  STATUS_CONFLICT="FAILED"
  FAILED=1
else
  echo -e "${GREEN}✓ No merge conflict markers found.${NC}"
  STATUS_CONFLICT="PASSED"
fi

# 2. Lint Staged Frontend Files
echo -e "\n${BOLD}[2/4] Checking Staged Frontend Files (ESLint)...${NC}"
STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '^frontend/' | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$STAGED_FRONTEND_FILES" ]; then
  echo "  -> Linting staged frontend files..."
  pushd frontend > /dev/null
  REL_FILES=$(echo "$STAGED_FRONTEND_FILES" | sed 's|^frontend/||')
  if ! npx eslint $REL_FILES > "$LOG_ESLINT" 2>&1; then
    cat "$LOG_ESLINT"
    echo -e "${RED}❌ ESLint checks failed on staged frontend files.${NC}"
    STATUS_ESLINT="FAILED"
    FAILED=1
  else
    echo -e "${GREEN}  ✓ Staged frontend files passed linting.${NC}"
    STATUS_ESLINT="PASSED"
  fi
  popd > /dev/null
else
  echo -e "${GREEN}✓ No staged JS/TS files in frontend to lint.${NC}"
  STATUS_ESLINT="PASSED (No staged files)"
fi

# 3. Frontend Type Check
echo -e "\n${BOLD}[3/4] Running Frontend Type Check (TypeScript)...${NC}"
if [ -d "frontend" ]; then
  pushd frontend > /dev/null
  if ! npm run typecheck > "$LOG_FE_TYPECHECK" 2>&1; then
    cat "$LOG_FE_TYPECHECK"
    echo -e "${RED}❌ Frontend type check failed.${NC}"
    STATUS_FE_TYPECHECK="FAILED"
    FAILED=1
  else
    echo -e "${GREEN}  ✓ Frontend type check passed.${NC}"
    STATUS_FE_TYPECHECK="PASSED"
  fi
  popd > /dev/null
else
  STATUS_FE_TYPECHECK="SKIPPED (Directory missing)"
fi

# 4. Backend Type Check
echo -e "\n${BOLD}[4/4] Running Backend Type Check (TypeScript)...${NC}"
if [ -d "backend" ]; then
  pushd backend > /dev/null
  if ! npm run typecheck > "$LOG_BE_TYPECHECK" 2>&1; then
    cat "$LOG_BE_TYPECHECK"
    echo -e "${RED}❌ Backend type check failed.${NC}"
    STATUS_BE_TYPECHECK="FAILED"
    FAILED=1
  else
    echo -e "${GREEN}  ✓ Backend type check passed.${NC}"
    STATUS_BE_TYPECHECK="PASSED"
  fi
  popd > /dev/null
else
  STATUS_BE_TYPECHECK="SKIPPED (Directory missing)"
fi

# Final Output & Detailed Error Report
echo ""
if [ $FAILED -ne 0 ]; then
  {
    echo "================================================================================"
    echo " ❌ PRE-COMMIT CHECK FAILURE REPORT"
    echo "================================================================================"
    echo "SUMMARY OF CHECKS:"
    echo "  [1/4] Unresolved Merge Conflicts: $STATUS_CONFLICT"
    echo "  [2/4] Frontend ESLint:            $STATUS_ESLINT"
    echo "  [3/4] Frontend Type Check:        $STATUS_FE_TYPECHECK"
    echo "  [4/4] Backend Type Check:         $STATUS_BE_TYPECHECK"
    echo ""

    if [ "$STATUS_CONFLICT" = "FAILED" ]; then
      echo "--------------------------------------------------------------------------------"
      echo "🔴 FAILED: [1/4] Unresolved Merge Conflict Markers"
      echo "--------------------------------------------------------------------------------"
      cat "$LOG_CONFLICT"
      echo ""
    fi

    if [ "$STATUS_ESLINT" = "FAILED" ]; then
      echo "--------------------------------------------------------------------------------"
      echo "🔴 FAILED: [2/4] Frontend ESLint Check"
      echo "Command to rerun: cd frontend && npx eslint <staged-files>"
      echo "--------------------------------------------------------------------------------"
      cat "$LOG_ESLINT"
      echo ""
    fi

    if [ "$STATUS_FE_TYPECHECK" = "FAILED" ]; then
      echo "--------------------------------------------------------------------------------"
      echo "🔴 FAILED: [3/4] Frontend Type Check (tsc)"
      echo "Command to rerun: cd frontend && npm run typecheck"
      echo "--------------------------------------------------------------------------------"
      cat "$LOG_FE_TYPECHECK"
      echo ""
    fi

    if [ "$STATUS_BE_TYPECHECK" = "FAILED" ]; then
      echo "--------------------------------------------------------------------------------"
      echo "🔴 FAILED: [4/4] Backend Type Check (tsc)"
      echo "Command to rerun: cd backend && npm run typecheck"
      echo "--------------------------------------------------------------------------------"
      cat "$LOG_BE_TYPECHECK"
      echo ""
    fi

    echo "================================================================================"
    echo "💡 HOW TO RESOLVE:"
    echo "  • Please fix the above reported errors before committing."
    echo "  • To bypass pre-commit checks in emergency: git commit --no-verify"
    echo "================================================================================"
  } | tee "$REPORT_LOG"

  exit 1
fi

# Clean up report log on success if it existed previously
rm -f "$REPORT_LOG"

echo -e "${GREEN}======================================================${NC}"
echo -e "${GREEN}${BOLD} ✨ All pre-commit checks passed successfully!       ${NC}"
echo -e "${GREEN}======================================================${NC}"
exit 0
